app:
    port 8069

get endpoint("/lista"):
    List<int> l = [10, 20, 30]
    l[0] = 99
    l[2] = l[1] + 5
    return { "l": l }

get endpoint("/dict"):
    Dict<string,int> d = { "a": 1 }
    d["b"] = 2
    d["a"] = d["a"] + 10
    return { "d": d }

get endpoint("/compuesto"):
    List<int> l = [1, 2, 3]
    l[0] += 10
    l[1] *= 5
    l[2]++
    return { "l": l }

get endpoint("/anidado"):
    Dict<string,int> d = {}
    List<int> idx = [0, 1, 2]
    int i = 0
    while i < 3:
        d[str(idx[i])] = idx[i] * 100
        i++
    return { "d": d }

get endpoint("/fuera"):
    List<int> l = [1]
    l[5] = 9
    return { "l": l }
