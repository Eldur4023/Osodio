app:
    port 8082

fn int doble(int x):
    return x * 2

fn string saluda(string nombre, string tratamiento = "hola"):
    return tratamiento + ", " + nombre

# Se puede llamar a una funcion declarada mas abajo.
fn int suma_hasta(int n):
    return acumula(n, 0)

fn int acumula(int n, int acc):
    if n <= 0:
        return acc
    return acumula(n - 1, acc + n)

fn bool es_par(int n):
    return n % 2 == 0

# Sin return explicito: devuelve null.
fn void registra(string msg):
    log.info("registro: " + msg)

get endpoint("/doble/:n", int n):
    return { "r": doble(n) }

get endpoint("/saluda/:quien", string quien):
    return { "a": saluda(quien), "b": saluda(quien, "buenas") }

get endpoint("/suma/:n", int n):
    return { "suma": suma_hasta(n) }

get endpoint("/anidado/:n", int n):
    return { "r": doble(doble(doble(n))) }

get endpoint("/filtra"):
    List<int> out = []
    for int x in [1, 2, 3, 4, 5, 6]:
        if es_par(x):
            out.add(doble(x))
    return { "out": out }

get endpoint("/void"):
    registra("desde el handler")
    return { "ok": true }

# Recursion sin caso base: tiene que cortar con un error, no agotar memoria.
fn int infinita(int n):
    return infinita(n + 1)

get endpoint("/desbordamiento"):
    return { "r": infinita(1) }

# Un error dentro de una funcion lo puede capturar quien la llama.
fn int rompe(int n):
    return n / 0

get endpoint("/captura/:n", int n):
    try:
        return { "no": rompe(n) }
    catch e:
        return { "capturado": e.message }
