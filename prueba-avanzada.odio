# ---------------------------------------------------------------
#  prueba-avanzada.odio
#  La otra mitad de la gramática: grupos y guardas, estado compartido,
#  SSE, WebSockets, handlers de error y control de la respuesta.
# ---------------------------------------------------------------


class Prefs:
    string  tema
    string? idioma

    validate:
        tema != ""              "tema: obligatorio"


# --- Grupos y guardas -------------------------------------------
# `require <expr> else <retorno>` sustituye al middleware entero.
# Tras delegar CORS, compresión, rate limiting y cabeceras de
# seguridad al reverse proxy, el único middleware que quedaba era
# proteger rutas — y eso es una condición con una salida.

group("/admin"):
    require session.role == "admin" else redirect("/invalid")

    get endpoint("/"):
        return render("admin.html")

    get endpoint("/users"):
        return render("admin_users.html")


group("/api/v1"):
    require jwt.valid else status(401)

    get endpoint("/me"):
        return { "sub": jwt.claims.sub, "role": jwt.claims.role }

    # Los grupos anidan y las guardas se acumulan: para llegar aquí
    # hay que pasar la del padre y luego la propia.
    group("/admin"):
        require jwt.claims.role == "admin" else status(403)

        get endpoint("/stats"):
            return { "usuarios": state.get("usuarios") }


# --- Estado compartido ------------------------------------------
# Hay un VM por hilo de event loop y ninguno comparte heap. `state`
# es la única vía de estado común entre hilos, y por eso expone
# operaciones y no propiedades: escribir
#
#     state.contador = state.contador + 1
#
# sería una carrera, porque entre la lectura y la escritura otro hilo
# puede haber cambiado el valor. `incr` es atómico y devuelve el
# valor ya actualizado.

get endpoint("/contador"):
    return { "count": state.get("contador") }

post endpoint("/contador/incr"):
    return { "count": state.incr("contador") }


# --- SSE --------------------------------------------------------
# `sse` ocupa la posición de método (siempre es un GET) y es además
# el objeto reservado del handler, igual que `session`.
#
# `await sleep(...)` despierta antes de tiempo si el cliente se
# desconecta, así que `sse.open` pasa a false y el bucle termina solo.

sse endpoint("/metrics/live"):
    sse.send("snapshot", { "count": state.get("contador") })

    int tick = 0
    while sse.open:
        await sleep(2000)

        tick = tick + 1
        sse.send("delta", { "count": state.get("contador"), "tick": tick })

        if tick % 10 == 0:
            sse.ping()


# --- WebSockets -------------------------------------------------
# Mismo patrón: `ws` en posición de método y como objeto reservado.
# `origins(...)` es obligatorio — sin lista blanca cualquier web puede
# abrir la conexión desde el navegador de tu usuario.

ws endpoint("/contador") origins("https://myapp.com", "http://localhost:5173"):
    ws.send({ "count": state.get("contador") })

    while ws.open:
        Json msg = await ws.recv()

        if msg == null:                     # el cliente cerró
            break

        # `Json` es dinámico por naturaleza, así que se sale de él con
        # accesores tipados y valor por defecto. No hay `Any` que
        # envenene el resto del sistema de tipos.
        string action = msg.string("action", "")

        if action == "increment":
            ws.send({ "count": state.incr("contador") })
        else if action == "decrement":
            ws.send({ "count": state.decr("contador") })
        else if action == "reset":
            state.set("contador", 0)
            ws.send({ "count": 0 })


# --- Control de la respuesta ------------------------------------
# Todo sale por `return`. El código, las cabeceras y las cookies se
# encadenan sobre lo que se devuelve, para no reintroducir un objeto
# `response` mutable que haya que arrastrar por el handler.

get endpoint("/descarga"):
    return send_file("/var/files/informe.pdf")
             .header("Content-Disposition", "attachment; filename=informe.pdf")

post endpoint("/preferencias", Prefs p):
    return redirect("/")
             .cookie("tema", p.tema, max_age=31536000, http_only=false)

get endpoint("/legacy"):
    return redirect("/nuevo", 301)


# --- Handlers de error ------------------------------------------
# `error` es un objeto reservado dentro de estos bloques.

on error 404:
    return render("404.html", path=request.path)

on error 422:
    return { "error": "Validación fallida", "detalles": error.messages }

on error:
    log.error(error.message)
    return render("500.html")
