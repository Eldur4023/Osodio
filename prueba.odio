import SQLite

Class User:
    int id
    string nombre
    int edad
    string contraseña

    User(int id):
        id = id
        nombre = ""
        edad = 0
        contraseña = ""
    
    User(int id, string nombre, int edad) # Por defecto se mapean todas las variables, las que no se ponen quedan como null (aqui contraseña es null)

fn User getuser(int id):
    SQLite.query("select nombre from users where id = ?", id)
    User user = SQLite.fetchone()
    return user

fn bool setuser(User user):
    
    try:
        Sqlite.query("insert into users ?, ?, ?", user.id, user.nombre, user.edad)
        return True
    catch:
        return False

get endpoint("/"):

    return render("index.html")

get endpoint("/login"):
    return render("login.html")

post endpoint("/login"):
    Dict data = petition.data()
    user =  data.nombre
    string pass = data.contraseña

    if checkpass(user, pass):
        session.login = true
        if isadmin(user):
            session.role= "admin"
        else:  
            session.role= "user"

    else:
        return render("login.html", error_window="Invalid password) #error_window es una variable junja del html

get endpoint("/admin"):

    if (session.role != "admin"):
        redirect("invalid")

    return render("admin.html")

get endpoint("/invalid")

    return render("invalid.html")


