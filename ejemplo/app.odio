# Proyecto de ejemplo de LoHin 2.0.
#   $ lohin ./ejemplo

app:
    name      "Ejemplo LoHin"
    version   "2.0.0"
    port      8080
    templates "./ejemplo/templates"

    static "/static" -> "./ejemplo/public"
    health


get endpoint("/"):
    return render("index.html", titulo="LoHin 2.0", nota="editame y guarda")

get endpoint("/hola"):
    return text("hola desde odio")

get endpoint("/api"):
    return { "ok": true, "motor": "lohin", "hito": 1 }

get endpoint("/ir"):
    return redirect("/")
