app:
    port 8071

class Caja:
    int n

get endpoint("/expresion"):
    int i = 5
    int a = i++          # a = 5, i = 6
    int b = ++i          # b = 7, i = 7
    int c = i--          # c = 7, i = 6
    int d = --i          # d = 5, i = 5
    return { "a": a, "b": b, "c": c, "d": d, "i": i }

get endpoint("/en_medio"):
    int i = 0
    return { "suma": i++ + i++ + i++, "i": i }

get endpoint("/campo"):
    Caja c = Caja(10)
    int viejo = c.n++
    int nuevo = ++c.n
    return { "viejo": viejo, "nuevo": nuevo, "n": c.n }

get endpoint("/sentencia"):
    int i = 0
    i++
    ++i
    i--
    return { "i": i }

get endpoint("/en_bucle"):
    int total = 0
    int k = 0
    while k < 5:
        total += k++
    return { "total": total, "k": k }

get endpoint("/indice"):
    List<int> l = [10, 20, 30]
    int i = 0
    return { "primero": l[i++], "segundo": l[i++], "i": i }
