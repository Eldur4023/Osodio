app:
    port 8072

class Contador:
    int n

    fn void sube():
        this.n++
        this.n += 10

get endpoint("/elif/:n", int n):
    if n < 0:
        return { "r": "negativo" }
    elif n == 0:
        return { "r": "cero" }
    elif n < 10:
        return { "r": "pequeno" }
    else:
        return { "r": "grande" }

# `else if` sigue valiendo, para no romper lo ya escrito.
get endpoint("/elseif/:n", int n):
    if n == 1:
        return { "r": "uno" }
    else if n == 2:
        return { "r": "dos" }
    else:
        return { "r": "otro" }

get endpoint("/compuestos"):
    int a = 10
    a += 5
    a -= 3
    a *= 2
    a /= 4
    a %= 4
    string s = "ho"
    s += "la"
    List<int> l = [1]
    l += [2, 3]
    return { "a": a, "s": s, "l": l }

get endpoint("/incrementos"):
    int i = 0
    i++
    i++
    ++i
    i--
    int j = 5
    --j
    return { "i": i, "j": j }

get endpoint("/en_bucle"):
    int total = 0
    int k = 0
    while k < 5:
        total += k
        k++
    return { "total": total, "k": k }

get endpoint("/campos"):
    Contador c = Contador(0)
    c.sube()
    c.n++
    return { "n": c.n }
