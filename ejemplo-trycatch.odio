app:
    port 8086

get endpoint("/basico/:n", int n):
    try:
        int x = n / 0
        return { "no": x }
    catch e:
        return { "capturado": e.message }

get endpoint("/sin_variable/:n", int n):
    try:
        int x = 1 % n
        return { "ok": x }
    catch:
        return { "fallo": true }

# El try no impide salir con return.
get endpoint("/return_dentro/:n", int n):
    try:
        return { "salida": n * 2 }
    catch e:
        return { "no_deberia": true }

# Un return dentro del try no puede dejar el manejador vivo para despues.
get endpoint("/no_fuga/:n", int n):
    int acc = 0
    for int i in [1, 2]:
        try:
            acc = acc + i
        catch e:
            acc = -1
    # Este fallo esta FUERA del try: tiene que reventar, no ser capturado.
    int malo = acc / 0
    return { "no": malo }

# Anidados: gana el mas interno.
get endpoint("/anidado"):
    try:
        try:
            int x = 1 / 0
        catch e:
            return { "interno": e.message }
    catch e:
        return { "externo": e.message }

# Se puede seguir tras capturar.
get endpoint("/sigue"):
    int total = 0
    for int d in [2, 0, 5]:
        try:
            total = total + 100 / d
        catch e:
            log.warn("saltado: " + e.message)
    return { "total": total }
