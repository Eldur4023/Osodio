# ---------------------------------------------------------------
#  prueba-revisada.odio
#  Convenciones: primitivos en minúscula (int, float, bool, string)
#                clases en mayúscula     (Dict, List, User)
#                true / false en minúscula
# ---------------------------------------------------------------

import SQLite          # módulo — fuera del alcance de 2.0, aquí solo para
                       # validar que el namespacing aguanta la sintaxis


# --- Modelos ----------------------------------------------------

class User:
    int     id
    string  nombre
    int     edad
    string? contraseña          # ? = puede faltar

    validate:
        nombre != ""            "nombre: obligatorio"
        edad >= 0               "edad: no puede ser negativa"

    User(int id):
        this.id = id
        this.nombre = ""
        this.edad = 0

    # Constructor por mapeo: sin cuerpo, los campos listados se asignan en orden.
    # Solo pueden omitirse los campos opcionales — aquí, contraseña.
    User(int id, string nombre, int edad)


class Login:
    string nombre
    string contraseña

    validate:
        nombre != ""            "nombre: obligatorio"
        contraseña != ""        "contraseña: obligatoria"


# --- Lógica de negocio ------------------------------------------

fn User getuser(int id):
    SQLite.query("select id, nombre, edad from users where id = ?", id)
    return SQLite.fetchone()

fn bool setuser(User user):
    try:
        SQLite.query("insert into users (id, nombre, edad) values (?, ?, ?)",
                     user.id, user.nombre, user.edad)
        return true
    catch e:
        log.error("insert falló: " + e.message)
        return false

fn bool checkpass(string nombre, string pass):
    return true                 # stub

fn bool isadmin(string nombre):
    return nombre == "admin"    # stub


# --- Rutas declarativas -----------------------------------------

get endpoint("/"):
    return render("index.html")

get endpoint("/login"):
    return render("login.html")

get endpoint("/invalid"):
    return render("invalid.html")


# --- Sesión (cookie firmada, sin estado en servidor) -------------

post endpoint("/login", Login data):
    if not checkpass(data.nombre, data.contraseña):
        return render("login.html", error_window="Credenciales inválidas")

    session.login = true
    session.role  = isadmin(data.nombre) ? "admin" : "user"
    return redirect("/")

get endpoint("/admin"):
    if session.role != "admin":
        return redirect("/invalid")

    return render("admin.html")


# --- CRUD -------------------------------------------------------

# El tipo del parámetro de ruta va en la firma, no dentro del string:
# el compilador verifica que ":id" existe en la ruta y que alguien lo recoge.
get endpoint("/user/:id", int id):
    return getuser(id)          # struct → JSON automático

# Query con valores por defecto.
get endpoint("/users", int page = 1, int limit = 20):
    SQLite.query("select id, nombre, edad from users limit ? offset ?",
                 limit, (page - 1) * limit)
    return SQLite.fetchall()

# El body es un parámetro tipado más. Si no parsea o no valida → 422
# automático y este cuerpo no llega a ejecutarse nunca.
post endpoint("/user", User user):
    return setuser(user) ? status(201) : status(400)
