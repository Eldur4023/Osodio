import sqlite

app:
    port 8070
    sqlite:
        file "./tx.db"
        pool 4

get endpoint("/crear"):
    await sqlite.exec("drop table if exists cuentas")
    await sqlite.exec("create table cuentas (id integer primary key autoincrement, nombre text, saldo integer)")
    await sqlite.exec("insert into cuentas (nombre, saldo) values ('ana', 100)")
    await sqlite.exec("insert into cuentas (nombre, saldo) values ('bob', 100)")
    return { "ok": true }

get endpoint("/saldos"):
    return await sqlite.query("select nombre, saldo from cuentas order by nombre")

# Transferencia atomica: las dos actualizaciones o ninguna.
post endpoint("/transfiere/:cuanto", int cuanto):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = saldo - ? where nombre = 'ana'", cuanto)
    await sqlite.exec("update cuentas set saldo = saldo + ? where nombre = 'bob'", cuanto)
    await sqlite.commit()
    return { "movido": cuanto }

# Se deshace a mano.
post endpoint("/deshecha/:cuanto", int cuanto):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = saldo - ? where nombre = 'ana'", cuanto)
    await sqlite.rollback()
    return { "deshecho": true }

# Sale sin cerrar: el driver tiene que deshacerla al terminar el handler.
post endpoint("/olvidada/:cuanto", int cuanto):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = saldo - ? where nombre = 'ana'", cuanto)
    return { "sin_cerrar": true }

# last_id tras un insert.
post endpoint("/alta/:nombre", string nombre):
    await sqlite.exec("insert into cuentas (nombre, saldo) values (?, 0)", nombre)
    int id = await sqlite.last_id()
    return { "id": id }
